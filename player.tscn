[gd_scene format=3 uid="uid://boqshgvgkdmi0"]

[ext_resource type="Script" uid="uid://cdwkng2mleoii" path="res://player.gd" id="1_player"]
[ext_resource type="Texture2D" uid="uid://bb7e63n74oggm" path="res://flt.jpg" id="2_head"]
[ext_resource type="Shader" uid="uid://du4ysq5qwqnfx" path="res://head_circle.gdshader" id="3_headshader"]
[ext_resource type="Script" path="res://player_animation.gd" id="4_anim"]
[ext_resource type="Script" path="res://dialog.gd" id="5_dialog"]

[sub_resource type="CircleShape2D" id="CircleShape2D_head"]
radius = 50.0

[sub_resource type="CircleShape2D" id="CircleShape2D_detector"]
radius = 58.0

[sub_resource type="ShaderMaterial" id="ShaderMaterial_head"]
shader = ExtResource("3_headshader")

; --- Estilo de la burbuja de texto ---------------------------------
; Un StyleBoxFlat es el "fondo dibujado" del PanelContainer: blanco
; con borde azul y esquinas redondeadas, con margen interior (padding)
; para que el texto no pegue en los bordes.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bubble"]
bg_color = Color(1, 1, 1, 0.95)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.12, 0.3, 0.55, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

; --- JUGADOR: solo la cabeza flotante -------------------------------
; El personaje ya no tiene cuerpo ni extremidades: es únicamente la
; imagen de la cabeza (recortada en círculo con el shader), centrada en
; el origen del CharacterBody2D. Así, la parte inferior de la cabeza
; apoya justo sobre las maderas.
[node name="Player" type="CharacterBody2D" unique_id=711896132]
script = ExtResource("1_player")

; Colisión circular centrada en el origen (coincide con la cabeza).
[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_head")

; --- DETECTOR DE COLECCIONABLES --------------------------------------
; Área algo mayor que la cabeza. Detecta los recogibles (capa 3) para
; entregar frases al tocarlos. No afecta al movimiento físico.
[node name="Detector" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 3
monitoring = true

[node name="Forma" type="CollisionShape2D" parent="Detector"]
shape = SubResource("CircleShape2D_detector")

; La cabeza. El script player_animation.gd le da vida (squash, balanceo,
; inclinación). Funciona con cualquier textura (foto actual o sprite futuro).
[node name="Head" type="Sprite2D" parent="."]
material = SubResource("ShaderMaterial_head")
scale = Vector2(0.078, 0.078)
texture = ExtResource("2_head")
script = ExtResource("4_anim")

; --- BURBUJA DE TEXTO FLOTANTE -------------------------------------
; Hija directa del Player para que NO rote con la cabeza. Se muestra/oculta
; con la tecla M. Empieza oculta.
[node name="SpeechBubble" type="PanelContainer" parent="."]
visible = false
offset_left = -140.0
offset_top = -175.0
offset_right = 140.0
offset_bottom = -135.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bubble")

; El Label dimensiona la burbuja: ancho fijo, el texto baja en líneas.
[node name="Label" type="Label" parent="SpeechBubble"]
custom_minimum_size = Vector2(280, 0)
theme_override_colors/font_color = Color(0.1, 0.1, 0.15, 1)
theme_override_font_sizes/font_size = 16
text = "¡Hola! Pulsa M para hablar."
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1

; --- GESTOR DE DIÁLOGO -----------------------------------------------
; Nodo independiente (dialog.gd) que gira las frases de la burbuja.
[node name="DialogueManager" type="Node" parent="."]
script = ExtResource("5_dialog")

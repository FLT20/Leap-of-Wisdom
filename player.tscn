; --- BURBUJA DE TEXTO FLOTANTE -------------------------------------
; Es hija directa del Player (no del cuerpo) para que NO rote ni se
; gire con la animacion. Es un PanelContainer: se AUTO-AJUSTA al
; tamano del texto que contenga (por eso "se adapta a la cantidad de
; texto"). Empieza oculta (visible=false); se muestra/oculta con M.
[node name="SpeechBubble" type="PanelContainer" parent="."]
visible = false
offset_left = -90.0
offset_top = -240.0
offset_right = 90.0
offset_bottom = -200.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bubble")

; El Label es el texto de dentro. Le ponemos un ancho FIJO (custom
; minimum size en X). Como el PanelContainer dimensiona a su hijo por
; su tamaño minimo, y el Label con autowrap respeta ese ancho, la
; burbuja NUNCA se ensancha mas de aqui: la frase larga BAJA en varias
; lineas y el panel crece hacia abajo (en alto), no hacia los lados.
[node name="Label" type="Label" parent="SpeechBubble"]
custom_minimum_size = Vector2(280, 0)
theme_override_colors/font_color = Color(0.1, 0.1, 0.15, 1)
theme_override_font_sizes/font_size = 16
text = "¡Hola! Pulsa M para hablar."
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1

; --- GESTOR DE DIÁLOGO -----------------------------------------------
; Nodo independiente (dialog.gd) que gira las frases de la burbuja
; por su cuenta. El jugador solo le pasa la lista de frases y le avisa
; cuando el jugador interactúa.
[node name="DialogueManager" type="Node" parent="."]
script = ExtResource("5_dialog")

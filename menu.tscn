[gd_scene load_steps=5 format=3]

; --- ESCENA DEL MENÚ PRINCIPAL ---------------------------------------
; Primera pantalla que ve el jugador: título + botón JUGAR + botón SALIR.
; El script es menu.gd. Para que arranque aquí, poner esta escena como
; "main scene" en los ajustes del proyecto.

[ext_resource type="Script" path="res://menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://cielo_textura.jpg" id="2_sky"]

; Fondo del panel: oscuro con borde azul y esquinas redondeadas.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.1, 0.14, 0.24, 0.92)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.3, 0.6, 0.95, 1)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24
content_margin_left = 40.0
content_margin_top = 40.0
content_margin_right = 40.0
content_margin_bottom = 40.0

; Fondo del botón: azul, esquinas redondeadas.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_boton"]
bg_color = Color(0.2, 0.5, 0.9, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14
content_margin_left = 20.0
content_margin_top = 14.0
content_margin_right = 20.0
content_margin_bottom = 14.0

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Fondo" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_sky")
expand_mode = 1
stretch_mode = 6

; Centro: mantiene el panel en el medio en cualquier resolución.
[node name="Centro" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Centro"]
layout_mode = 2
custom_minimum_size = Vector2(480, 0)
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Caja" type="VBoxContainer" parent="Centro/Panel"]
layout_mode = 2
theme_override_constants/separation = 22

[node name="Titulo" type="Label" parent="Centro/Panel/Caja"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0.1, 0.3, 0.6, 0.9)
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 64
text = "Salto de Sabiduría"
horizontal_alignment = 1

[node name="Subtitulo" type="Label" parent="Centro/Panel/Caja"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.88, 1, 0.95)
theme_override_font_sizes/font_size = 20
text = "Salta de madera en madera y sube lo más alto que puedas"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Separador" type="Control" parent="Centro/Panel/Caja"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="BotonJugar" type="Button" parent="Centro/Panel/Caja"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 32
theme_override_styles/normal = SubResource("StyleBoxFlat_boton")
theme_override_styles/hover = SubResource("StyleBoxFlat_boton")
theme_override_styles/pressed = SubResource("StyleBoxFlat_boton")
text = "JUGAR"

[node name="BotonSalir" type="Button" parent="Centro/Panel/Caja"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 1, 1)
theme_override_font_sizes/font_size = 22
text = "SALIR"

[node name="SeparadorIdiomas" type="Control" parent="Centro/Panel/Caja"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[node name="BotonIdioma" type="Button" parent="Centro/Panel/Caja"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 1, 1)
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = SubResource("StyleBoxFlat_boton")
theme_override_styles/hover = SubResource("StyleBoxFlat_boton")
theme_override_styles/pressed = SubResource("StyleBoxFlat_boton")
text = "Idioma"

; --- CUADRO EMERGENTE DE SELECCIÓN DE IDIOMA -------------------------
; Cubre toda la pantalla (con un velo oscuro) y muestra un panel centrado
; con los dos idiomas. Empieza oculto; se abre al pulsar "Idioma".
[node name="CuadroIdioma" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Velo" type="ColorRect" parent="CuadroIdioma"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="Centro" type="CenterContainer" parent="CuadroIdioma"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="CuadroIdioma/Centro"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Caja" type="VBoxContainer" parent="CuadroIdioma/Centro/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Titulo" type="Label" parent="CuadroIdioma/Centro/Panel/Caja"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.88, 1, 0.95)
theme_override_font_sizes/font_size = 22
text = "Selecciona un idioma"
horizontal_alignment = 1

[node name="BotonES" type="Button" parent="CuadroIdioma/Centro/Panel/Caja"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 24
theme_override_styles/normal = SubResource("StyleBoxFlat_boton")
theme_override_styles/hover = SubResource("StyleBoxFlat_boton")
theme_override_styles/pressed = SubResource("StyleBoxFlat_boton")
theme_override_styles/disabled = SubResource("StyleBoxFlat_panel")
text = "Español"

[node name="BotonEN" type="Button" parent="CuadroIdioma/Centro/Panel/Caja"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 24
theme_override_styles/normal = SubResource("StyleBoxFlat_boton")
theme_override_styles/hover = SubResource("StyleBoxFlat_boton")
theme_override_styles/pressed = SubResource("StyleBoxFlat_boton")
theme_override_styles/disabled = SubResource("StyleBoxFlat_panel")
text = "English"
